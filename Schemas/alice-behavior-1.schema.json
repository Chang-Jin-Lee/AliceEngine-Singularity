{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alice-behavior-1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "x-alice-format": "schema-id",
      "description": "항상 alice/behavior/1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "사람이 읽는 이름. 문서 안에서 참조 대상이 된다"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "type": "string",
            "x-alice-format": "expression",
            "description": "조건식. 예) input.pressed(\"Jump\") and physics.grounded"
          },
          "do": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "title": "Action",
              "description": "동사 하나와 그 인자. 예) audio.play: { sound: sounds/jump.sound.yaml }"
            },
            "minItems": 1,
            "description": "실행할 동작 목록"
          },
          "once": {
            "type": "boolean",
            "description": "한 번만 실행하고 다시는 하지 않을지",
            "default": false
          },
          "cooldown": {
            "type": "number",
            "description": "재실행까지의 최소 간격(초)",
            "default": 0.0
          }
        },
        "required": [
          "when",
          "do"
        ],
        "additionalProperties": false,
        "title": "Rule",
        "description": "조건이 참이 되는 순간 동작들을 순서대로 실행한다"
      },
      "minItems": 1,
      "description": "규칙 목록"
    },
    "variables": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "type": "number"
      },
      "description": "이 행동이 쓰는 지역 변수와 초깃값"
    }
  },
  "required": [
    "schema",
    "name",
    "rules"
  ],
  "additionalProperties": false,
  "title": "Behavior",
  "description": "액터의 동작을 규칙으로 적는다. **이 엔진에는 게임플레이 스크립트 언어가 없다.** 언리얼의 C++/블루프린트, 유니티의 C# 이 있던 자리를 이 문서가 대신한다. 규칙은 선언적이고, 순서에 의존하지 않으며, 조건이 참이 될 때만 실행된다",
  "examples": [
    {
      "when": "input.pressed(\"Jump\") and physics.grounded"
    }
  ],
  "x-alice-pitfalls": [
    {
      "wrong": "do: audio.play",
      "right": "do:\n  - audio.play: { sound: ... }",
      "why": "do 는 항상 목록이고, 각 항목은 동사 하나를 키로 갖는 맵이다"
    }
  ],
  "x-alice-schema-id": "alice/behavior/1"
}
