{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alice-input-1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "x-alice-format": "schema-id",
      "description": "항상 alice/input/1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "사람이 읽는 이름. 문서 안에서 참조 대상이 된다"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "사람이 읽는 이름. 문서 안에서 참조 대상이 된다"
          },
          "type": {
            "type": "string",
            "enum": [
              "button",
              "axis",
              "axis2"
            ],
            "description": "값의 모양"
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "물리 입력. 예) [key.space, gamepad.a, touch.tap]"
          },
          "deadzone": {
            "type": "number",
            "description": "축 입력의 데드존",
            "default": 0.15
          }
        },
        "required": [
          "name",
          "type",
          "bindings"
        ],
        "additionalProperties": false,
        "title": "Input Action"
      },
      "minItems": 1,
      "description": "행동 목록"
    }
  },
  "required": [
    "schema",
    "name",
    "actions"
  ],
  "additionalProperties": false,
  "title": "Input Map",
  "description": "물리 입력을 이름 있는 행동으로 바꾼다. 행동 문서는 키가 아니라 이름을 참조하므로 PC·패드·터치를 같은 콘텐츠로 지원할 수 있다",
  "x-alice-schema-id": "alice/input/1"
}
