{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alice-component-light-1.schema.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "directional",
        "point",
        "spot"
      ],
      "description": "광원 종류"
    },
    "color": {
      "anyOf": [
        {
          "type": "string",
          "x-alice-format": "color-hex",
          "description": "16진 색상. 예) \"#ff8800\""
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      ],
      "description": "색상. \"#rrggbb\" 문자열 또는 [r, g, b, a] 배열(0..1)",
      "default": "#ffffff"
    },
    "intensity": {
      "type": "number",
      "description": "세기. directional 은 lux, 나머지는 lumen 기준",
      "default": 1.0
    },
    "range": {
      "type": "number",
      "description": "도달 거리(미터). point/spot 전용",
      "default": 10.0
    },
    "spotAngle": {
      "type": "number",
      "description": "스팟 원뿔 각도(도). spot 전용",
      "default": 45.0
    },
    "castShadow": {
      "type": "boolean",
      "description": "그림자를 만들지. 켤수록 비싸다",
      "default": false
    },
    "shadowBias": {
      "type": "number",
      "description": "그림자 여드름을 줄이는 오프셋",
      "default": 0.005
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "title": "Light",
  "description": "장면을 밝힌다",
  "x-alice-schema-id": "alice/component/light/1"
}
