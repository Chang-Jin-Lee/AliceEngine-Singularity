    {
      "id": "log.write",
      "summary": "구조화 로그를 남긴다",
      "description": "콘텐츠가 남긴 로그도 엔진 로그와 같은 NDJSON 스트림으로 나간다. 그래서 AI 가 '이 규칙이 언제 몇 번 발동했나'를 엔진 이벤트와 나란히 놓고 볼 수 있다. 게임플레이 버그를 쫓을 때 이게 가장 빠른 길이다",
      "tags": [
        "diagnostics"
      ],
      "deterministic": true,
      "cost": "trivial",
      "args": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "trace",
              "debug",
              "info",
              "warn",
              "error"
            ],
            "description": "로그 레벨",
            "default": "info"
          },
          "event": {
            "type": "string",
            "x-alice-format": "verb-id",
            "description": "안정 이벤트 id. 예) gameplay.player.died"
          },
          "message": {
            "type": "string",
            "description": "사람이 읽을 한 문장"
          },
          "fields": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "기계가 읽을 키-값. 숫자는 숫자로 남겨라"
          }
        },
        "required": [
          "event"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "log.write": {
            "event": "gameplay.player.jumped",
            "fields": {
              "height": 2.4
            }
          }
        }
      ]
    },
